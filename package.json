{
  "name": "solari-cookbook-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Solari Cookbook & Autonomous Agent Orchestration Platform",
  "type": "module",
  "workspaces": [
    "projects/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "agent": "npm run --workspace=projects/solari-autonomous-engineer start --",
    "career": "npm run --workspace=projects/solari-autonomous-engineer start -- career",
    "mcp": "npm run --workspace=projects/solari-mcp-server start",
    "studio": "npm run --workspace=projects/solari-autonomous-engineer studio"
  },
  "keywords": [
    "solari",
    "ai-agent",
    "autonomous-engineer",
    "sandbox",
    "browser",
    "desktop",
    "mcp",
    "rrweb",
    "playwright"
  ],
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.2"
  },
  "author": "Prashanth (@kprsnt2 / kprsnt.in)",
  "license": "MIT"
}
