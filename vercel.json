{
  "version": 2,
  "cleanUrls": true,
  "framework": null,
  "outputDirectory": "projects/solari-autonomous-engineer/src/web/public",
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/api/run",
      "dest": "/api/run.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/projects/solari-autonomous-engineer/src/web/public/$1"
    }
  ]
}
